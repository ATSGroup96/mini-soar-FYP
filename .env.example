# =============================================================================
# Mini-SOAR settings. Copy this file to ".env" and fill in the values.
#   .env is ignored by git - NEVER commit real keys.
# Lines marked (optional) can stay empty.
# =============================================================================

# --- Safety / scope -----------------------------------------------------------
# Master switch. The engine refuses to scan or fix anything unless this is true.
AUTHORIZED_LAB_ONLY=true
# Networks the engine may touch (comma separated, your own lab only).
ALLOWED_RANGES=192.168.56.0/24
# Addresses that are never scanned or changed (the engine PC is added by itself).
DENY_HOSTS=192.168.56.1
# dashboard = scope is managed in Settings -> Network scope (admin + 2FA);
# env = only the two lines above count.
SCOPE_SOURCE=dashboard
# Upper limit for what the dashboard may allow (optional; default = private ranges).
SCOPE_CEILING=
# true = fixes are only previewed, never executed (global kill switch).
FORCE_DRY_RUN=false

# --- Where the engine runs ----------------------------------------------------
# native = directly on Windows (Nmap + Npcap), host = Kali/Linux in Docker,
# nat = Docker Desktop on Windows (weaker scan).
NETWORK_MODE=native
# nat mode only: this PC's lab address with prefix, e.g. 192.168.56.1/24 (optional).
ENGINE_HOST_IPS=
# Full path of nmap.exe (or its folder) when it is not on PATH (optional).
NMAP_PATH=
# Seconds nmap may spend on one host before giving up (optional, default 300).
SCAN_HOST_TIMEOUT=300
# Windows native: 1 = dashboard in development mode (live reload), 0 = built version.
DEV_MODE=0

# --- Supabase (cloud database + login) ----------------------------------------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
# Service role key: engine only. Never put it in the dashboard or in git.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# auto = the API runs on the same machine as the dashboard, port 8000.
NEXT_PUBLIC_API_URL=auto

# --- Encryption / signing -----------------------------------------------------
# 32 random bytes, base64. Create one with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
AES_KEY_B64=GENERATE-A-32-BYTE-BASE64-KEY
# Any long random text. Signs every stored scan bundle.
HMAC_KEY=

# --- CVE intelligence ---------------------------------------------------------
INTEL_DB_PATH=./data/intel.sqlite
# Free key from https://nvd.nist.gov/developers/request-an-api-key (optional, faster sync).
NVD_API_KEY=
NVD_SYNC_DAYS=30

# --- Honeypot IP reputation (optional, free tiers) ----------------------------
ABUSEIPDB_API_KEY=
OTX_API_KEY=

# --- Remediation over SSH -----------------------------------------------------
SSH_PRIVATE_KEY_PATH=./secrets/lab_id_rsa
SSH_USERNAME=soar

# --- 2FA ----------------------------------------------------------------------
TOTP_ISSUER=Mini-SOAR-Lab

# --- Web push notifications (optional) ----------------------------------------
# Create the pair with:  python -m common.webpush gen-keys
VAPID_PRIVATE_KEY=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_SUBJECT=mailto:admin@mini-soar.local

# --- Syslog / SIEM (optional) -------------------------------------------------
SYSLOG_HOST=127.0.0.1
SYSLOG_PORT=514
SYSLOG_PROTO=udp
